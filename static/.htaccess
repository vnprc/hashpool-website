# Cache policy for the published site. Zola copies this file into the web root.
#
# The build pins every file's mtime to the epoch so deploys compare cleanly, which
# leaves Last-Modified and Apache's size-plus-mtime ETag unable to tell a same-size
# change from no change: a browser revalidating either gets 304 and keeps the old
# copy. Drop both validators and let max-age drive a full refetch; the pages are
# small. Without any Cache-Control, browsers apply heuristic freshness of a tenth of
# the apparent age since 1970, about five years, and never ask again.
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
  Header unset Last-Modified
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "max-age=600"
  </FilesMatch>
  # Every .css is held for a year under its address: link each one with
  # cachebust=true, as head.html does, or a change to it never arrives.
  <FilesMatch "\.css$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "max-age=86400"
  </FilesMatch>
</IfModule>
