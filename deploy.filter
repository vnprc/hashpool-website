# Paths in the docroot that belong to the host, not to this site.  rclone sync
# does not delete a destination path that a filter excludes, so these survive a
# deploy that removes everything else no longer in the site.
#
# .well-known is the one that matters: DirectAdmin answers ACME challenges from
# it, so deleting it does nothing visible today and breaks certificate renewal
# about sixty days later.
- /.well-known/**
- /.htaccess
- /stats/**
- /cgi-bin/**
